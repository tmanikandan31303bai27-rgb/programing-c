#include <stdbool.h>

bool dfs(char** board, int m, int n, int i, int j, char* word, int index) {
    // If all characters matched
    if (word[index] == '\0') return true;

    // Boundary check + mismatch
    if (i < 0 || i >= m || j < 0 || j >= n || board[i][j] != word[index])
        return false;

    // Mark visited
    char temp = board[i][j];
    board[i][j] = '#';

    // Explore 4 directions
    bool found = dfs(board, m, n, i + 1, j, word, index + 1) ||
                 dfs(board, m, n, i - 1, j, word, index + 1) ||
                 dfs(board, m, n, i, j + 1, word, index + 1) ||
                 dfs(board, m, n, i, j - 1, word, index + 1);

    // Backtrack (restore)
    board[i][j] = temp;

    return found;
}

bool exist(char** board, int boardSize, int* boardColSize, char* word) {
    int m = boardSize;
    int n = boardColSize[0];

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            if (dfs(board, m, n, i, j, word, 0)) {
                return true;
            }
        }
    }

    return false;
}

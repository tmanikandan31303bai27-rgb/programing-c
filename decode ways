int charToint(char *s){
    int ans = 0;
    ans = (s[0] - '0') * 10 + s[1] - '0';
    return ans;
}

int numDecodings(char * s){
    int lenS = strlen(s);
    if(s[0] == '0')
        return 0;   
    
    if(lenS == 0 || lenS ==1)
        return 1;

    int a = 1;
    int b;
    int temp = charToint(s);
    if(temp == 10 || temp == 20)
        b = 1;
    else if(temp%10 == 0)
        return 0;
    else if(temp > 26)
        b = 1;
    else
        b = 2;
    
    if(lenS == 2)
        return b;
    int c;
    for(int i = 2; i < lenS; i++ ){
        temp = charToint(&s[i-1]); 
        if(temp == 0)
            return 0;
        else if(temp > 0 && temp < 10)  // 01-09
            c = b;
        else if(temp == 10 || temp== 20 )  //10, 20
            c = a;
        else if(temp%10 == 0)  //30 40 50 ...90
            return 0;
        else  if(temp > 26)
            c = b;
        else 
            c = a + b;
            
        a = b;
        b = c;   
    }
        
    return c;

}

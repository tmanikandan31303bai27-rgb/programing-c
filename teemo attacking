#include <stdio.h>
#include <stdlib.h>

/**
 * Problem: 495. Teemo Attacking
 * Logic: For each attack at time[i], the poison lasts until time[i] + duration.
 * If the next attack at time[i+1] happens before the poison ends, 
 * we only count the gap between them (time[i+1] - time[i]).
 */
int findPoisonedDuration(int* timeSeries, int timeSeriesSize, int duration) {
    // Edge case: no attacks
    if (timeSeriesSize == 0) return 0;
    
    int totalDuration = 0;
    
    // Iterate through all attacks except the last one
    for (int i = 0; i < timeSeriesSize - 1; i++) {
        int gap = timeSeries[i + 1] - timeSeries[i];
        
        // If gap is smaller than duration, add gap (overlap case)
        // Otherwise, add full duration (no overlap)
        if (gap < duration) {
            totalDuration += gap;
        } else {
            totalDuration += duration;
        }
    }
    
    // Always add the full duration for the final attack
    totalDuration += duration;
    
    return totalDuration;
}

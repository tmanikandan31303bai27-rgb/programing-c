/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     struct TreeNode *left;
 *     struct TreeNode *right;
 * };
 */
void countdepth(struct TreeNode* root, int depth, int *max){
    if(root == NULL){
        return;
    }
    if(depth > *max){
        *max = depth;
    }

    countdepth(root->left, depth + 1, max);
    countdepth(root->right, depth + 1, max);
}

int maxDepth(struct TreeNode* root) {
    if(root == NULL) 
        return 0;
    
    int max = 0;
    countdepth(root, 1, &max);//+root
    
    return max; 
}
